rules_version = '2';

// Negado por padrão. Cada usuário acessa somente users/{seuUid} e coleções explicitamente listadas abaixo.
// Nenhuma permissão depende de campo editável pelo cliente (ex.: "role").
// Cada nova coleção (clientes, projetos...) ganha sua própria regra com validação nos próximos commits.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Preferências do usuário (users/{uid}.preferences). Os itens das listas (atalhos) são validados no cliente:
    // as regras limitam só o tamanho das listas.
    function validPreferences(p) {
      return p is map
        && p.keys().hasOnly(['locale', 'currency', 'theme', 'dateStyle', 'weekStart', 'context', 'hiddenBlocks', 'externalLinks', 'followUpDays'])
        && (!('locale' in p) || p.locale is string)
        && (!('currency' in p) || p.currency in ['BRL', 'USD', 'EUR', 'PYG'])
        && (!('theme' in p) || p.theme in ['system', 'light', 'dark'])
        && (!('dateStyle' in p) || p.dateStyle in ['br', 'iso'])
        && (!('weekStart' in p) || p.weekStart in ['sun', 'mon'])
        && (!('context' in p) || p.context in ['today', 'development', 'editing', 'commercial'])
        && (!('hiddenBlocks' in p) || (p.hiddenBlocks is list && p.hiddenBlocks.size() <= 10))
        && (!('externalLinks' in p) || (p.externalLinks is list && p.externalLinks.size() <= 10))
        && (!('followUpDays' in p) || p.followUpDays in [3, 7, 14, 30]);
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'preferences', 'createdAt', 'updatedAt'])
        && d.email is string
        && d.displayName is string
        && validPreferences(d.preferences);
    }

    function validTask() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'status', 'priority', 'due', 'category', 'tags',
                               'clientId', 'projectId', 'completedAt', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['backlog', 'todo', 'in_progress', 'waiting', 'done', 'cancelled']
        && d.priority in ['low', 'medium', 'high']
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('due' in d) || d.due == null || d.due is timestamp)
        && (!('clientId' in d) || d.clientId == null || d.clientId is string)
        && (!('projectId' in d) || d.projectId == null || d.projectId is string);
    }

    function validClient() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'company', 'email', 'phone', 'source', 'status', 'notes',
                               'nextAction', 'nextActionDate', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.status in ['lead', 'active', 'inactive', 'archived']
        && (!('company' in d) || (d.company is string && d.company.size() <= 120))
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('source' in d) || (d.source is string && d.source.size() <= 60))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000))
        && (!('nextAction' in d) || (d.nextAction is string && d.nextAction.size() <= 200))
        && (!('nextActionDate' in d) || d.nextActionDate == null || d.nextActionDate is timestamp);
    }

    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'description', 'clientId', 'type', 'status', 'priority',
                               'startDate', 'dueDate', 'links', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['development', 'editing', 'social_media', 'internal', 'other']
        && d.status in ['planning', 'active', 'waiting_client', 'review', 'completed', 'archived']
        && d.priority in ['low', 'medium', 'high']
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('clientId' in d) || d.clientId == null || d.clientId is string)
        && (!('startDate' in d) || d.startDate == null || d.startDate is timestamp)
        && (!('dueDate' in d) || d.dueDate == null || d.dueDate is timestamp)
        && (!('links' in d) || (d.links is list && d.links.size() <= 10));
    }

    function validMilestone() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'date', 'done', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.done is bool
        && (!('date' in d) || d.date == null || d.date is timestamp);
    }

    function validJournal() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'text', 'createdAt'])
        && d.date is timestamp
        && d.text is string && d.text.size() > 0 && d.text.size() <= 5000;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'type', 'allDay', 'start', 'end', 'description', 'projectId',
                               'reminderMinutes', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.type in ['meeting', 'appointment', 'milestone']
        && d.allDay is bool
        && d.start is timestamp
        && (!('end' in d) || d.end == null || (d.end is timestamp && d.end >= d.start))
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('projectId' in d) || d.projectId == null || d.projectId is string)
        && (!('reminderMinutes' in d) || d.reminderMinutes == null || d.reminderMinutes in [0, 10, 30, 60, 1440]);
    }

    function validProposal() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'summary', 'clientId', 'amount', 'currency', 'sentDate', 'validUntil',
                               'status', 'nextAction', 'nextActionDate', 'projectId', 'lastActivityAt',
                               'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.clientId is string && d.clientId.size() > 0
        && d.amount is number && d.amount >= 0 && d.amount <= 1000000000000
        && d.currency in ['BRL', 'USD', 'EUR', 'PYG']
        && d.status in ['draft', 'sent', 'negotiation', 'accepted', 'rejected', 'expired']
        && (!('summary' in d) || (d.summary is string && d.summary.size() <= 5000))
        && (!('nextAction' in d) || (d.nextAction is string && d.nextAction.size() <= 200))
        && (!('projectId' in d) || d.projectId == null || d.projectId is string)
        && (!('sentDate' in d) || d.sentDate == null || d.sentDate is timestamp)
        && (!('validUntil' in d) || d.validUntil == null || d.validUntil is timestamp)
        && (!('nextActionDate' in d) || d.nextActionDate == null || d.nextActionDate is timestamp)
        && (!('lastActivityAt' in d) || d.lastActivityAt == null || d.lastActivityAt is timestamp);
    }

    function validProposalHistory() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'from', 'to', 'at'])
        && d.kind in ['created', 'status', 'contact']
        && (d.from == null || d.from in ['draft', 'sent', 'negotiation', 'accepted', 'rejected', 'expired'])
        && (d.to == null || d.to in ['draft', 'sent', 'negotiation', 'accepted', 'rejected', 'expired'])
        && d.at is timestamp;
    }

    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasOnly(['description', 'type', 'amount', 'currency', 'status', 'dueDate', 'paidDate',
                               'category', 'clientId', 'projectId', 'notes', 'createdAt', 'updatedAt'])
        && d.description is string && d.description.size() > 0 && d.description.size() <= 160
        && d.type in ['income', 'expense']
        && d.amount is number && d.amount > 0 && d.amount <= 1000000000000
        && d.currency in ['BRL', 'USD', 'EUR', 'PYG']
        && d.status in ['planned', 'pending', 'paid', 'cancelled']
        && d.dueDate is timestamp
        && (d.status != 'paid' || (('paidDate' in d) && d.paidDate is timestamp))
        && (d.status == 'paid' || !('paidDate' in d) || d.paidDate == null)
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000))
        && (!('clientId' in d) || d.clientId == null || d.clientId is string)
        && (!('projectId' in d) || d.projectId == null || d.projectId is string);
    }

    function validActiveTimer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['start', 'description', 'taskId', 'projectId', 'billable'])
        && d.start is timestamp
        && d.description is string && d.description.size() <= 200
        && d.billable is bool
        && (d.taskId == null || d.taskId is string)
        && (d.projectId == null || d.projectId is string);
    }

    function validTimeEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['description', 'taskId', 'projectId', 'start', 'end', 'durationSeconds', 'billable',
                               'source', 'revisionCount', 'createdAt', 'updatedAt'])
        && d.start is timestamp && d.end is timestamp
        && d.end.toMillis() > d.start.toMillis()
        && d.end.toMillis() - d.start.toMillis() <= 86400000
        && d.durationSeconds is int
        && math.abs(d.durationSeconds * 1000 - (d.end.toMillis() - d.start.toMillis())) <= 1000
        && d.description is string && d.description.size() <= 200
        && d.billable is bool
        && d.source in ['timer', 'manual']
        && d.revisionCount is int && d.revisionCount >= 0
        && (d.taskId == null || d.taskId is string)
        && (d.projectId == null || d.projectId is string);
    }

    function validNote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'content', 'tags', 'clientId', 'projectId', 'taskId', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() <= 160
        && d.content is string && d.content.size() > 0 && d.content.size() <= 10000
        && d.tags is list && d.tags.size() <= 20
        && (d.clientId == null || d.clientId is string)
        && (d.projectId == null || d.projectId is string)
        && (d.taskId == null || d.taskId is string);
    }

    function validWorkLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'done', 'blockers', 'nextStep', 'clientId', 'projectId', 'taskId', 'createdAt', 'updatedAt'])
        && d.date is timestamp
        && d.done is string && d.done.size() <= 5000
        && d.blockers is string && d.blockers.size() <= 5000
        && d.nextStep is string && d.nextStep.size() <= 5000
        && (d.done.size() > 0 || d.blockers.size() > 0 || d.nextStep.size() > 0)
        && (d.clientId == null || d.clientId is string)
        && (d.projectId == null || d.projectId is string)
        && (d.taskId == null || d.taskId is string);
    }

    function validInteraction() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'type', 'summary', 'createdAt'])
        && d.date is timestamp
        && d.type in ['call', 'email', 'meeting', 'message', 'other']
        && d.summary is string && d.summary.size() > 0 && d.summary.size() <= 2000;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask();
      }

      match /projects/{projectId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProject();

        match /milestones/{milestoneId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validMilestone();
        }

        match /journal/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validJournal();
        }
      }

      // Cronômetro ativo: UM documento de ID fixo ("current"). O início é a hora do servidor e não pode ser trocado
      // enquanto o cronômetro existe — assim, iniciar um segundo cronômetro é negado pelo servidor.
      match /timer/{timerId} {
        allow read, delete: if isOwner(uid) && timerId == 'current';
        allow create: if isOwner(uid) && timerId == 'current' && validActiveTimer()
                      && request.resource.data.start == request.time;
        allow update: if isOwner(uid) && timerId == 'current' && validActiveTimer()
                      && request.resource.data.start == resource.data.start;
      }

      match /timeEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTimeEntry();

        // Valores anteriores de cada ajuste: só criação (imutável).
        match /revisions/{revisionId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
                        && request.resource.data.keys().hasOnly(['before', 'at'])
                        && request.resource.data.before is map
                        && request.resource.data.at is timestamp;
          allow update: if false;
        }
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote();
      }

      match /workLog/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWorkLog();
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTransaction();
      }

      match /proposals/{proposalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProposal();

        match /history/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validProposalHistory();
          allow update: if false; // histórico não é editável
        }
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent();
      }

      match /clients/{clientId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validClient();

        match /interactions/{interactionId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validInteraction();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
