rules_version = '2';

// Negado por padrão. Cada usuário acessa somente users/{seuUid} e coleções explicitamente listadas abaixo.
// Nenhuma permissão depende de campo editável pelo cliente (ex.: "role").
// Cada nova coleção (clientes, projetos...) ganha sua própria regra com validação nos próximos commits.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'preferences', 'createdAt', 'updatedAt'])
        && d.email is string
        && d.displayName is string
        && d.preferences is map;
    }

    function validTask() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'status', 'priority', 'due', 'category', 'tags',
                               'clientId', 'projectId', 'completedAt', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['backlog', 'todo', 'in_progress', 'waiting', 'done', 'cancelled']
        && d.priority in ['low', 'medium', 'high']
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('due' in d) || d.due == null || d.due is timestamp)
        && (!('clientId' in d) || d.clientId == null || d.clientId is string)
        && (!('projectId' in d) || d.projectId == null || d.projectId is string);
    }

    function validClient() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'company', 'email', 'phone', 'source', 'status', 'notes',
                               'nextAction', 'nextActionDate', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.status in ['lead', 'active', 'inactive', 'archived']
        && (!('company' in d) || (d.company is string && d.company.size() <= 120))
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('source' in d) || (d.source is string && d.source.size() <= 60))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000))
        && (!('nextAction' in d) || (d.nextAction is string && d.nextAction.size() <= 200))
        && (!('nextActionDate' in d) || d.nextActionDate == null || d.nextActionDate is timestamp);
    }

    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'description', 'clientId', 'type', 'status', 'priority',
                               'startDate', 'dueDate', 'links', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['development', 'editing', 'social_media', 'internal', 'other']
        && d.status in ['planning', 'active', 'waiting_client', 'review', 'completed', 'archived']
        && d.priority in ['low', 'medium', 'high']
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('clientId' in d) || d.clientId == null || d.clientId is string)
        && (!('startDate' in d) || d.startDate == null || d.startDate is timestamp)
        && (!('dueDate' in d) || d.dueDate == null || d.dueDate is timestamp)
        && (!('links' in d) || (d.links is list && d.links.size() <= 10));
    }

    function validMilestone() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'date', 'done', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.done is bool
        && (!('date' in d) || d.date == null || d.date is timestamp);
    }

    function validJournal() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'text', 'createdAt'])
        && d.date is timestamp
        && d.text is string && d.text.size() > 0 && d.text.size() <= 5000;
    }

    function validInteraction() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'type', 'summary', 'createdAt'])
        && d.date is timestamp
        && d.type in ['call', 'email', 'meeting', 'message', 'other']
        && d.summary is string && d.summary.size() > 0 && d.summary.size() <= 2000;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask();
      }

      match /projects/{projectId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProject();

        match /milestones/{milestoneId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validMilestone();
        }

        match /journal/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validJournal();
        }
      }

      match /clients/{clientId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validClient();

        match /interactions/{interactionId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validInteraction();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
