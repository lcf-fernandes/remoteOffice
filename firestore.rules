rules_version = '2';

// Negado por padrão. Cada usuário acessa somente users/{seuUid} e coleções explicitamente listadas abaixo.
// Nenhuma permissão depende de campo editável pelo cliente (ex.: "role").
// Cada nova coleção (clientes, projetos...) ganha sua própria regra com validação nos próximos commits.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'preferences', 'createdAt', 'updatedAt'])
        && d.email is string
        && d.displayName is string
        && d.preferences is map;
    }

    function validTask() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'status', 'priority', 'due', 'category', 'tags',
                               'clientId', 'projectId', 'completedAt', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['backlog', 'todo', 'in_progress', 'waiting', 'done', 'cancelled']
        && d.priority in ['low', 'medium', 'high']
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('category' in d) || (d.category is string && d.category.size() <= 60))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('due' in d) || d.due == null || d.due is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
