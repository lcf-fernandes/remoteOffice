# Copie para .env (que está no .gitignore) e preencha com os valores do app Web no console do Firebase.
# Estes valores são públicos por natureza; a proteção dos dados vem das regras do Firestore.
# NUNCA coloque aqui service account, chave privada ou credenciais administrativas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
